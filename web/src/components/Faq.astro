---
const faqKeys = [1, 2, 3, 4, 5, 6, 7, 8] as const;
---

<section id="faq" class="section-wrapper">
    <div class="container">
        
        <div class="header-center">
            <span class="badge" data-i18n="faq.badge">Wissen</span>
            <h2 data-i18n="faq.title">Häufige Fragen</h2>
            <p class="subtitle" data-i18n="faq.subtitle">Alles, was du über den Ablauf wissen musst.</p>
        </div>

        <div class="faq-list">
            {faqKeys.map((n) => (
                <div class="faq-item">
                    <button class="faq-question" type="button">
                        <span data-i18n={`faq.q${n}`}>
                          {n === 1 && 'Was ist Startplatzboerse.com?'}
                          {n === 2 && 'Kostet die Nutzung wirklich nichts?'}
                          {n === 3 && 'Wie kann ich einen Startplatz verkaufen?'}
                          {n === 4 && 'Wie kaufe ich einen Startplatz?'}
                          {n === 5 && 'Ist der Kauf sicher?'}
                          {n === 6 && 'Fallen Ummeldegebühren an?'}
                          {n === 7 && 'Welche Events finde ich hier?'}
                          {n === 8 && 'Ich habe noch eine Frage.'}
                        </span>
                        <span class="icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        </span>
                    </button>
                    <div class="faq-answer">
                        <div class="answer-content">
                            <p data-i18n-html={`faq.a${n}`}></p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>

<script>
    const questions = document.querySelectorAll('.faq-question');
    
    questions.forEach(q => {
        q.addEventListener('click', () => {
            const item = q.parentElement;
            item?.classList.toggle('active');
        });
    });
</script>

<style>
    .section-wrapper { 
        padding: 100px 20px; 
        background: var(--bg-body);
        position: relative;
    }

    .container { 
        background: var(--bg-body);
        max-width: 800px; 
        margin: 0 auto; 
    }

    .header-center { text-align: center; margin-bottom: 50px; }
    
    .badge { 
        color: var(--cyan); font-weight: 700; text-transform: uppercase; 
        letter-spacing: 1px; font-size: 0.8rem; display: block; margin-bottom: 10px; 
    }
    h2 { font-size: 2.5rem; color: white; margin-bottom: 10px; }
    .subtitle { color: var(--text-muted); font-size: 1.1rem; }

    .faq-list { display: flex; flex-direction: column; gap: 15px; }

    .faq-item {
        background: var(--bg-card);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.05);
        overflow: hidden;
        transition: 0.3s ease;
    }
    
    .faq-item:hover { border-color: rgba(255,255,255,0.15); }
    .faq-item.active { border-color: rgba(0, 188, 212, 0.3); }

    .faq-question {
        width: 100%;
        text-align: left;
        padding: 20px 25px;
        background: none; border: none;
        color: white; 
        font-weight: 600; font-size: 1.05rem;
        cursor: pointer;
        display: flex; justify-content: space-between; align-items: center;
        gap: 12px;
    }

    .icon { 
        color: var(--cyan); 
        transition: transform 0.3s ease; 
        display: flex; align-items: center;
        flex-shrink: 0;
    }
    .faq-item.active .icon { transform: rotate(45deg); }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s cubic-bezier(0, 1, 0, 1);
    }
    
    .answer-content {
        padding: 0 25px 25px 25px;
        color: var(--text-muted);
        line-height: 1.6;
        font-size: 0.95rem;
    }

    .answer-content :global(strong) { color: white; }

    .faq-item.active .faq-answer {
        max-height: 800px;
        transition: max-height 0.3s ease-in-out;
    }
</style>
