---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { ratgeberArticleKey } from '../i18n';

const allArticles = await getCollection('ratgeber');
const sortedArticles = allArticles.sort((a, b) => {
  const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
  const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
  return dateB - dateA;
});

const title = "Ratgeber & Magazin | Startplatzbörse";
const description = "Profitiere von Experten-Tipps zu Training, Ernährung und dem sicheren Kauf von Startplätzen.";
---

<Layout title={title} description={description}>
  <main>
    <header class="hero">
      <div class="hero-content">
        <span class="beta-badge" data-i18n="ratgeber.indexBadge">Wissen & Inspiration</span>
        <h1 data-i18n="ratgeber.indexTitle">Der Ratgeber</h1>
        <p class="hero-sub" data-i18n="ratgeber.indexSub">
          Tipps rund um Training und Wettkampf — geschrieben für unsere Community.
        </p>
      </div>
    </header>

    <section class="ratgeber-section">
      <div class="container">
        <div class="ratgeber-grid">
          {sortedArticles.map((article) => {
            const articleKey = ratgeberArticleKey(article);
            return (
            <a href={`/ratgeber/${article.slug}`} class="ratgeber-card">
              <div
                class="ratgeber-image"
                style={`background-image: url(${article.data.image});`}
              >
              </div>
              <div class="ratgeber-content">
                <span
                  class="badge"
                  style="font-size: 0.7rem;"
                  data-i18n={`ratgeber.articles.${articleKey}.category`}
                >
                  {article.data.category || 'Tipp'}
                </span>
                <h3 data-i18n={`ratgeber.articles.${articleKey}.title`}>{article.data.title}</h3>
                <p data-i18n={`ratgeber.articles.${articleKey}.teaser`}>{article.data.teaser}</p>
                <div class="read-more" data-i18n="ratgeber.readNow">
                  Jetzt lesen →
                </div>
              </div>
            </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>

   <Footer />

</Layout>

<style>
    :root {
        --bg-actual: #323232; 
--cyan: #00bcd4;
        --text-muted: #aaa;
    }

    .hero {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(
            to bottom,
            #454545 0%,
            #383838 60%,
            var(--bg-actual) 100%
        );
        padding: 140px 20px 80px;
    }

    .hero-content {
        max-width: 900px;
        z-index: 10;
    }

    .beta-badge {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #888;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 8px 20px;
        border-radius: 50px;
        display: inline-block;
        margin-bottom: 25px;
    }

    h1 {
        font-size: clamp(2.8rem, 9vw, 5.5rem);
        font-weight: 900;
        line-height: 1.05;
        margin: 0 0 30px 0;
        letter-spacing: -3px;
        color: white;
    }

    .hero-sub {
        font-size: 1.3rem;
        color: var(--text-muted);
        max-width: 650px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .ratgeber-section {
        padding: 80px 0 120px;
        background-color: var(--bg-actual);
    }

    .container { 
        max-width: 1200px; 
        margin: 0 auto;
        padding: 0 20px;
    }

    .badge { 
        color: var(--cyan); 
        font-weight: 800; 
        text-transform: uppercase; 
        font-size: 0.8rem; 
        letter-spacing: 1px; 
    }

    .ratgeber-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .ratgeber-card {
        background: var(--bg-card);
        border-radius: 20px;
        overflow: hidden;
        text-decoration: none;
        transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
    }

    .ratgeber-card:hover {
        transform: translateY(-8px);
        border-color: var(--cyan);
    }

    .ratgeber-image {
        height: 250px;
        background-size: cover;
        background-position: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ratgeber-content {
        padding: 35px;
        flex-grow: 1;
    }

    .ratgeber-content h3 {
        color: white;
        font-size: 1.8rem;
        margin: 10px 0 15px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.5px;
    }

    .ratgeber-content p {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .read-more {
        color: var(--cyan);
        font-weight: 700;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
    }

    @media (max-width: 768px) {
        .ratgeber-grid {
            grid-template-columns: 1fr;
        }
        h1 { font-size: 3.5rem; }
        .hero { min-height: 50vh; padding-top: 100px; }
    }

</style>
