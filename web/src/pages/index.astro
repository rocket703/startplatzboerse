---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import SocialShare from '../components/SocialShare.astro';
import WhatsNew from '../components/WhatsNew.astro';
import ServerOutageNotice from '../components/ServerOutageNotice.astro';
import Footer from '../components/Footer.astro';
import Infos from '../components/Infos.astro';
import Faq from '../components/Faq.astro';
import EventCard from '../components/EventCard.astro';
import { ratgeberArticleKey } from '../i18n';
import { createClient } from '@supabase/supabase-js';
import { getCollection } from 'astro:content';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// Wir holen alle genehmigten Inserate, sortiert nach Datum (neuere zuerst)
const listingColumns =
  'id, user_id, category, event_name, event_date, location, distance, distance_km, price, price_type, old_price';

const { data: listingsRaw, error } = await supabase
  .from('listings')
  .select(listingColumns)
  .eq('approved', true)
  .eq('status', 'active')
  .order('created_at', { ascending: false })
  .limit(4);

const sellerIds = [...new Set((listingsRaw ?? []).map((row) => row.user_id).filter(Boolean))];
let nicknameByUserId: Record<string, string> = {};

if (sellerIds.length > 0) {
  const { data: sellers } = await supabase
    .from('profiles_public')
    .select('id, nickname')
    .in('id', sellerIds);

  nicknameByUserId = Object.fromEntries(
    (sellers ?? []).map((row) => [row.id, row.nickname ?? 'Gast']),
  );
}

const listings = (listingsRaw ?? []).map((item) => ({
  ...item,
  profiles: { nickname: nicknameByUserId[item.user_id] ?? 'Gast' },
}));

const { data: statsRows } = await supabase.rpc('get_homepage_stats');
const rawStats = (statsRows?.[0] ?? {}) as Record<string, unknown>;
const homepageStats = {
  listings_count: Number(rawStats.listings_count ?? 0),
  users_count: Number(rawStats.users_count ?? 0),
  sold_count: Number(rawStats.sold_count ?? 0),
};
const formatStat = (value: unknown) =>
  (Number.isFinite(Number(value)) ? Number(value) : 0).toLocaleString('de-DE');

  // ARTIKEL AUF STARTSEITE ALDEN UND SORTIEREN
 const allRatgeber = await getCollection('ratgeber');

const ratgeberTeaser = allRatgeber
  .sort((a, b) => {
    // Wir wandeln beide Daten in Zahlen um und vergleichen sie
    return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
  })
  .slice(0, 4);
---

<Layout
  title="Startplätze kaufen & verkaufen"
  description="Die Community für Startplätze: Angebote für Marathon, Triathlon, Radrennen und Hyrox finden, inserieren und sicher handeln."
>
    
    <div class="hero">
        <div class="hero-utility-bar">
            <SocialShare />
            <WhatsNew />
        </div>

        <div class="hero-content">
            <h1><span data-i18n="home.heroLine1">Dein Rennen.</span><br> <span class="text-cyan" data-i18n="home.heroLine2">Mein Startplatz.</span></h1>

            <div class="stats-row">
                <div class="stat-card">
                    <span class="stat-number">{formatStat(homepageStats.users_count)}</span>
                    <span class="stat-label" data-i18n="home.statUsers">Registrierte Nutzer</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">{formatStat(homepageStats.listings_count)}</span>
                    <span class="stat-label" data-i18n="home.statListings">Inserierte Startplätze</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">{formatStat(homepageStats.sold_count)}</span>
                    <span class="stat-label" data-i18n="home.statSold">Erfolgreich vermittelt</span>
                </div>
            </div>
            
            <p class="hero-sub" data-i18n-html="home.heroSub">
                Die neue Plattform für Lauf, Rad, Triathlon & Hyrox.<br>
                Fair. Transparent. <br> <strong>Von privat an privat.</strong>
            </p>
            
            <div class="btn-group">
                <a href="#listings" class="btn-primary" data-i18n="home.findSpot">Startplatz finden</a>
                <a href="/inserieren" class="btn-secondary" data-i18n="home.listSpot">Platz inserieren</a>
            </div>
        </div>
    </div>

 <section class="trust-box-section">
    <div class="container">
        
        <div class="trust-grid">
            
           <div class="trust-card">
                <div class="trust-icon-container">
                    <svg class="trust-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                    </svg>
                    <div class="icon-glow"></div>
                </div>
                <h3 data-i18n="home.trustCommunityTitle">Echte Community</h3>
                <p data-i18n="home.trustCommunityText">Von Privat an Privat. Du kaufst direkt von anderen Athleten. Wir stellen die Technik bereit, damit ihr euch findet. Ohne Zwischenhändler.</p>
            </div>

            <div class="trust-card">
                <div class="trust-icon-container">
                    <svg class="trust-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751A11.959 11.959 0 0112 2.714z" />
                    </svg>
                    <div class="icon-glow"></div>
                </div>
                <h3 data-i18n="home.trustFairTitle">Faire Abwicklung</h3>
                <p data-i18n="home.trustFairText">Direkte Kommunikation zwischen dem Verkäufer und dir. Seid fair zu einander und gestaltet so ein positives Erlebnis für uns Alle.</p>
            </div>

            <div class="trust-card">
                <div class="trust-icon-container">
                    <svg class="trust-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                    <div class="icon-glow"></div>
                </div>
                <h3 data-i18n="home.trustFastTitle">Einfach & Schnell</h3>
                <p data-i18n="home.trustFastText">In 2 Minuten inseriert, blitzschnell gefunden. Egal ob Last-Minute oder lang geplanter Start. Hier wird jeder fündig.</p>
            </div>

        </div>
    </div>
</section>

  <section class="listings-preview" id="listings">
    <div class="container">
        <div class="section-header">
            <div class="header-title">
                <span class="badge" data-i18n="home.listingsBadge">Aktuell</span>
                <h2 data-i18n="home.listingsTitle">Neueste Inserate</h2>
            </div>
            </div>

        <div class="event-grid">
            {listings && listings.map((item: any) => (
                <EventCard 
                    id={item.id}
                    category={item.category}
                    title={item.event_name}
                    date={new Date(item.event_date).toLocaleDateString('de-DE')}
                    location={item.location}
                    distance={item.distance}
                    price={item.price}
                    priceType={item.price_type}
                    oldPrice={item.old_price}
                    nickname={item.profiles?.nickname || "Gast"}
                />
            ))}
        </div>
            
        {(!listings || listings.length === 0) && (
            <p class="no-listings" data-i18n="home.noListings">Aktuell keine Startplätze verfügbar. Inseriere den ersten!</p>
        )}

        <div class="section-footer">
            <a href="/suche" class="view-all" data-i18n="home.viewAll">Alle anzeigen →</a>
        </div>
    </div> 
</section>

    <Infos />

    <section class="listings-preview">
    <div class="container">
        <div class="section-header">
            <div class="header-title">
                <span class="badge" data-i18n="home.guideBadge">Wissen & Tipps</span>
                <h2 data-i18n="home.guideTitle">Ratgeber</h2>
            </div>
            </div>

        <div class="ratgeber-grid">
            {ratgeberTeaser.map((artikel) => {
                const articleKey = ratgeberArticleKey(artikel);
                return (
                <a href={`/ratgeber/${artikel.slug}`} class="ratgeber-card">
                    <div class="ratgeber-image" style={`background-image: url(${artikel.data.image})`}></div>
                    <div class="ratgeber-content">
                        <h3 data-i18n={`ratgeber.articles.${articleKey}.title`}>{artikel.data.title}</h3>
                        <p data-i18n={`ratgeber.articles.${articleKey}.teaser`}>{artikel.data.teaser}</p>
                        <span class="read-more" data-i18n="home.readArticle">Artikel lesen →</span>
                    </div>
                </a>
                );
            })}
        </div>

        <div class="section-footer">
             <a href="/ratgeber" class="view-all" data-i18n="home.viewAll">Alle anzeigen →</a>
        </div>
    </div>
</section>

    <Faq />

    <Footer />

    {/* Störungshinweis: ein/aus in ServerOutageNotice.astro (OUTAGE_NOTICE_ENABLED) */}
    <ServerOutageNotice />

</Layout>

<style>
    /* --- VARIABLEN & RESET --- */
    :root {
        --bg-actual: #323232; /* Dein Haupt-Hintergrund */
        --cyan: #00bcd4;
        --text-muted: #aaa;
    }

    /* Verhindert Blitzer beim Scrollen */
    :global(body) {
        background-color: var(--bg-actual);
        margin: 0;
        padding: 0;
    }

    /* --- HERO SEKTION --- */
    .hero {
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        /* Nahtloser Übergang von Hellgrau zu deinem Seiten-Grau */
        background: linear-gradient(
        to bottom,
         #454545 0%,
         #383838 60%,
        var(--bg-actual) 100%
        );
        padding: 100px 20px 80px;
        margin: 0;
        border: none;
    }

    .hero-content {
        max-width: 900px;
        z-index: 10;
        margin: 0 auto;
        width: 100%;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* Gleiche Außenbreite wie Desktop-Dock — Social links, „Was ist neu?“ rechts bündig */
    .hero-utility-bar {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        width: 100%;
        max-width: 1050px;
        margin: 0 auto 2rem;
        padding: 0;
        z-index: 10;
        flex-shrink: 0;
        box-sizing: border-box;
    }

    .hero-utility-bar :global(.badge-container),
    .hero-utility-bar :global(.whats-new-trigger-wrap) {
        margin: 0;
        flex-shrink: 0;
    }

    .hero-utility-bar :global(.whats-new-trigger-wrap) {
        display: flex;
        justify-content: flex-end;
    }

    @media (min-width: 900px) {
        .hero {
            padding-top: 96px;
        }

        .hero-utility-bar {
            width: min(1050px, calc(100vw - 40px));
            max-width: calc(100vw - 40px);
            justify-content: center;
            gap: clamp(100px, 16vw, 240px);
            padding: 0;
        }
    }

    @media (max-width: 899px) {
        .hero-utility-bar {
            padding: 0 5px;
        }
    }

    @media (max-width: 520px) {
        .hero-utility-bar {
            flex-direction: row;
            align-items: center;
            gap: 10px;
            padding: 0 5px;
        }

        .hero-utility-bar :global(.whats-new-pill) {
            width: auto;
        }
    }

    .beta-badge {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #888;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 8px 20px;
        border-radius: 50px;
        display: inline-block;
        margin-bottom: 25px;
    }

    h1 {
        font-size: clamp(2.8rem, 9vw, 5.5rem);
        font-weight: 900;
        line-height: 1.05;
        margin-bottom: 30px;
        letter-spacing: -3px;
        color: white;
    }

    .text-cyan { 
        color: var(--cyan); 
        text-shadow: 0 0 40px rgba(0, 188, 212, 0.3); 
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        width: 100%;
        max-width: 760px;
        margin: 0 auto 36px;
    }

    @property --stat-card-angle {
        syntax: '<angle>';
        initial-value: 0deg;
        inherits: false;
    }

    .stat-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        min-width: 0;
        padding: 16px 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        backdrop-filter: blur(10px);
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1px;
        background: conic-gradient(
            from var(--stat-card-angle),
            transparent 0%,
            transparent 85%,
            rgba(0, 188, 212, 0.9) 93%,
            transparent 100%
        );
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
        animation: stat-card-spin 6s linear infinite;
    }

    @keyframes stat-card-spin {
        to {
            --stat-card-angle: 360deg;
        }
    }

    .stat-number,
    .stat-label {
        position: relative;
        z-index: 1;
    }

    .stat-number {
        color: var(--cyan);
        font-size: clamp(1.4rem, 4vw, 2rem);
        font-weight: 900;
        line-height: 1.1;
    }

    .stat-label {
        color: #888;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        text-align: center;
        line-height: 1.35;
    }

    @media (prefers-reduced-motion: reduce) {
        .stat-card::before {
            animation: none;
            background: rgba(0, 188, 212, 0.35);
            -webkit-mask: none;
            mask: none;
            padding: 0;
            border: 1px solid rgba(0, 188, 212, 0.35);
        }
    }

    .hero-sub {
        font-size: 1.3rem;
        color: var(--text-muted);
        max-width: 650px;
        margin: 0 auto 50px;
        line-height: 1.6;
    }

    /* --- BUTTONS (Fix für unterschiedliche Höhen) --- */
    .btn-group { 
        display: flex; 
        gap: 20px; 
        justify-content: center; 
        flex-wrap: wrap; 
        align-items: center; 
    }

    .btn-primary, .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box; /* WICHTIG */
        min-height: 64px;       /* Identische Höhe für beide */
        padding: 0 38px;
        border-radius: 50px; 
        text-decoration: none;
        font-size: 1.1rem;
        transition: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .btn-primary {
        background: var(--cyan); 
        color: white; 
        font-weight: 700;
        border: 5px solid transparent;
        box-shadow: 0 10px 20px rgba(0, 188, 212, 0.2);
    }

    .btn-primary:hover { 
        transform: translateY(-3px); 
        box-shadow: 0 15px 30px rgba(0, 188, 212, 0.4); 
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.03); 
        color: white; 
        font-weight: 600;
        border: 1px solid rgba(255,255,255,0.1); 
    }

    .btn-secondary:hover { 
        background: rgba(255,255,255,0.08); 
        border-color: white; 
    }

    /* --- LISTINGS PREVIEW (Unter dem Hero) --- */
    .listings-preview {
        padding: 80px 0 100px;
        background-color: var(--bg-actual);
    }
    
    .container { 
        max-width: 1200px; 
        margin: 0 auto;
        padding: 0 20px;
    }
    
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 60px;
    }

    .badge { 
        color: var(--cyan); 
        font-weight: 800; 
        text-transform: uppercase; 
        font-size: 0.8rem; 
        letter-spacing: 1px; 
    }

    h2 { 
        font-size: 2.8rem; 
        color: white; 
        font-weight: 900; 
        margin-top: 10px; 
        letter-spacing: -1px; 
    }

    .view-all { 
        color: var(--cyan); 
        text-decoration: none; 
        font-weight: 600; 
        transition: 0.3s; 
    }

    .view-all:hover { opacity: 0.8; }

    /* EVENT GRID */
    .event-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 30px; 
    }

    /* RESPONSIVE DESIGN */
    @media (max-width: 768px) {
        .event-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        
        .section-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 40px;
        }
        
        h2 { font-size: 2.2rem; }
        
        .hero { min-height: 70vh; padding-top: 80px; }

        .stats-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }
    }

    /* --- CSS FÜR DAS NEUE LAUNCH BANNER --- */
    .launch-banner {
        background-color: var(--bg-card); /* Dunkles Karten-Design */
        border: 1px solid rgba(0, 188, 212, 0.3); /* Dezenter Cyan-Rand */
        border-radius: 20px;
        padding: 40px;
        margin: 40px auto 60px; /* Zentriert mit Abstand */
        max-width: 900px;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 188, 212, 0.05);
    }

    .launch-badge {
        display: inline-block;
        background: rgba(0, 188, 212, 0.1);
        color: var(--cyan);
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 20px;
    }

    .launch-title {
        font-size: 2.2rem;
        color: white;
        margin: 0 0 15px 0;
        font-weight: 900;
        letter-spacing: -1px;
    }

    .launch-text {
        color: var(--text-muted);
        font-size: 1.1rem;
        line-height: 1.6;
        max-width: 700px;
        margin: 0 auto 30px;
    }

    .launch-text strong {
        color: white;
    }

    .launch-buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    /* Das Toast Popup CSS */
    #custom-toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        background: var(--bg-card);
        color: white;
        padding: 14px 28px;
        border-radius: 50px;
        border: 1px solid var(--cyan);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(0, 188, 212, 0.2);
        font-weight: 600;
        z-index: 9999;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        pointer-events: none;
    }

    #custom-toast.toast-visible {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }
    
    /* Mobil-Optimierung */
    @media (max-width: 600px) {
        .launch-banner { padding: 30px 20px; border-radius: 16px; }
        .launch-title { font-size: 1.6rem; }
        .launch-buttons { flex-direction: column; }
        .launch-buttons .btn-primary, .launch-buttons .btn-secondary { width: 100%; }
    }

    @media (max-width: 768px) {
        .event-grid {
            grid-template-columns: 1fr;
            gap: 20px;
            width: 100%; /* Zwingt das Grid auf volle Breite */
        }
        
        /* Zwingt die Karten im Grid, die volle Breite zu nutzen */
        .event-grid > * {
            width: 100%;
            max-width: 100%; 
            margin: 0 auto;
        }
        

    }

    /* --- RATGEBER SEKTION --- */
    .ratgeber-section {
        padding: 80px 0;
        background-color: var(--bg-actual);
    }

    .ratgeber-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .ratgeber-card {
        background: var(--bg-card);
        border-radius: 20px;
        overflow: hidden;
        text-decoration: none;
        transition: transform 0.3s ease, border-color 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
    }

    .ratgeber-card:hover {
        transform: translateY(-5px);
        border-color: var(--cyan);
    }

    .ratgeber-image {
        height: 200px;
        background-size: cover;
        background-position: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ratgeber-content {
        padding: 30px;
    }

    .ratgeber-content h3 {
        color: white;
        font-size: 1.5rem;
        margin-bottom: 15px;
        line-height: 1.3;
    }

    .ratgeber-content p {
        color: var(--text-muted);
        font-size: 1rem;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .read-more {
        color: var(--cyan);
        font-weight: 700;
        font-size: 0.9rem;
    }

    /* Mobil-Anpassung für Ratgeber */
    @media (max-width: 768px) {
        .ratgeber-grid {
            grid-template-columns: 1fr;
        }
    }

.section-footer {
    width: 100%;
    display: flex;
    justify-content: flex-end; /* Schiebt den Inhalt ganz nach rechts */
    margin-top: 3rem; /* Sorgt für ordentlich Abstand nach oben (ca. 48px) */
}

.section-footer .view-all {
    font-size: 1.25rem; /* Macht die Schrift etwas größer (ca. 20px) */
    font-weight: 600; /* Macht die Schrift etwas kräftiger, damit sie auffällt */
}

.section-header {
    display: flex;
    justify-content: flex-start; /* Zwingt den gesamten Inhalt nach links */
    width: 100%;
}

.header-title {
    text-align: left; /* Stellt sicher, dass auch der Text selbst linksbündig ist */
    margin-right: auto; /* Nimmt den restlichen Platz rechts ein und drückt die Überschrift nach links */
}

/* --- TRUST BOX SEKTION (NEU) --- */
    .trust-box-section {
        padding: 60px 0 100px;
        background-color: var(--bg-actual); /* Gleicher Hintergrund wie Listings */
    }

    .trust-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        text-align: center;
    }

    .trust-card {
        background: var(--bg-card);
        padding: 40px 30px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .trust-card:hover {
        transform: translateY(-5px);
        border-color: rgba(0, 188, 212, 0.2);
    }

    .trust-icon-container {
        position: relative;
        width: 80px;
        height: 80px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .trust-icon {
        width: 50px;
        height: 50px;
        color: var(--cyan); /* Brandfarbe nutzen */
        z-index: 2; /* Über dem Glow */
    }

    .icon-glow {
        position: absolute;
        width: 100%;
        height: 100%;
        background: var(--cyan);
        border-radius: 50%;
        filter: blur(35px); /* Macht den weichen Glow-Effekt */
        opacity: 0.15; /* Ganz dezent halten */
        z-index: 1;
    }

    .trust-card h3 {
        color: white;
        font-size: 1.5rem;
        margin-bottom: 12px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .trust-card p {
        color: var(--text-muted);
        font-size: 1rem;
        line-height: 1.6;
        margin: 0;
    }

    .trust-card p strong {
        color: white; /* Hebt wichtige Begriffe hervor */
    }

    /* Mobil-Optimierung für Trust Sektion */
    @media (max-width: 900px) {
        .trust-grid {
            grid-template-columns: 1fr; /* Karten untereinander */
            gap: 20px;
            max-width: 500px; /* Verhindert zu breite Karten auf Handys */
            margin: 0 auto;
        }
        
        .trust-card {
            padding: 30px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const shareBtn = document.getElementById('share-platform-btn');
        const toast = document.getElementById('custom-toast');
        
        function showToast() {
            if (!toast) return;
            toast.className = 'toast-visible';
            setTimeout(() => {
                toast.className = 'toast-hidden';
            }, 3000); // Verschwindet nach 3 Sekunden
        }

        if (shareBtn) {
            shareBtn.addEventListener('click', async () => {
                const shareData = {
                    title: 'Startplatzbörse',
                    text: 'Die neue Plattform von Athleten für Athleten! Finde und inseriere Startplätze für Triathlon, Laufen, Radrennen und Hyrox.',
                    url: 'https://startplatzboerse.com'
                };

                try {
                    if (navigator.share) {
                        await navigator.share(shareData);
                    } else {
                        // Der schicke Fallback für den PC
                        await navigator.clipboard.writeText(shareData.url);
                        showToast();
                    }
                } catch (err) {
                    console.log('Teilen abgebrochen.', err);
                }
            });
        }
    });
</script>